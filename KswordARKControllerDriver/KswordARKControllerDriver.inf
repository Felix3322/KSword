;
; Manual-binding companion for a dedicated, non-boot storage controller.
; Never preinstall this INF on the controller that hosts Windows or mounted data.
;

[Version]
Signature="$WINDOWS NT$"
Class=SCSIAdapter
ClassGuid={4D36E97B-E325-11CE-BFC1-08002BE10318}
Provider=%ManufacturerName%
CatalogFile=KswordARKController.cat
DriverVer=
PnpLockDown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskName%,,,""

[SourceDisksFiles]
KswordARKController.sys=1,,

[Manufacturer]
%ManufacturerName%=Standard,NTamd64.10.0...19041

[Standard.NTamd64.10.0...19041]
%AhciDeviceDesc%=Controller_Install,PCI\CC_010601
%NvmeDeviceDesc%=Controller_Install,PCI\CC_010802
%IdeDeviceDesc%=Controller_Install,PCI\CC_0101

[Controller_Install.NT]
CopyFiles=Driver_Copy

[Controller_Install.NT.HW]
AddReg=Controller_Security

[Controller_Security]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[Driver_Copy]
KswordARKController.sys

[Controller_Install.NT.Services]
AddService=KswordARKController,%SPSVCINST_ASSOCSERVICE%,Service_Install

[Service_Install]
DisplayName=%ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\KswordARKController.sys

[Controller_Install.NT.Wdf]
KmdfService=KswordARKController,Wdf_Section

[Wdf_Section]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE=0x00000002
ManufacturerName="Ksword"
DiskName="Ksword controller research companion"
AhciDeviceDesc="Ksword dedicated AHCI research controller"
NvmeDeviceDesc="Ksword dedicated NVMe research controller"
IdeDeviceDesc="Ksword dedicated IDE research controller"
ServiceDesc="Ksword storage controller research companion"
